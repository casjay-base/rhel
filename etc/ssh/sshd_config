#	$OpenBSD: sshd_config,v 1.93 2014/01/10 05:59:19 djm Exp $
Port 22
AddressFamily any
Protocol 2
HostKey /etc/ssh/ssh_host_rsa_key
HostKey /etc/ssh/ssh_host_ecdsa_key
HostKey /etc/ssh/ssh_host_ed25519_key

RekeyLimit default none
SyslogFacility AUTHPRIV

LoginGraceTime 300
PermitRootLogin yes
StrictModes yes
MaxAuthTries 3
MaxSessions 99999
# OpenSSH's compiled-in default (10:30:100) throttles/drops new
# unauthenticated connections once 10 are concurrently open - under a
# brute-force flood (dozens of bot IPs hammering at once, which these
# internet-facing hosts see constantly) this hits legitimate
# connections too, producing "kex_exchange_identification: read:
# connection reset by peer" on the client before the SSH banner even
# arrives. fail2ban is the actual abuse-mitigation layer (AI.md's
# "Firewall policy" section); this limit should only ever be a sanity
# ceiling, not something real traffic runs into.
MaxStartups 100:30:200
IgnoreRhosts yes
KeepAlive yes

PermitEmptyPasswords no
PasswordAuthentication yes

ChallengeResponseAuthentication no

#KerberosAuthentication no
#KerberosOrLocalPasswd yes
#KerberosTicketCleanup yes
#KerberosGetAFSToken no
#KerberosUseKuserok yes

# GSSAPI options
GSSAPIAuthentication yes
GSSAPICleanupCredentials no
#GSSAPIStrictAcceptorCheck yes
#GSSAPIKeyExchange no
#GSSAPIEnablek5users no

UsePAM yes
X11Forwarding yes
X11UseLocalhost yes
PermitTTY yes
Banner /etc/casjaysdev/banners/ssh.txt
PrintMotd no
PrintLastLog yes
TCPKeepAlive yes
#UsePrivilegeSeparation yes

# Accept locale-related environment variables
AcceptEnv LANG LC_CTYPE LC_NUMERIC LC_TIME LC_COLLATE LC_MONETARY LC_MESSAGES
AcceptEnv LC_PAPER LC_NAME LC_ADDRESS LC_TELEPHONE LC_MEASUREMENT
AcceptEnv LC_IDENTIFICATION LC_ALL LANGUAGE
AcceptEnv XMODIFIERS

# override default of no subsystems
Subsystem sftp /usr/libexec/openssh/sftp-server
